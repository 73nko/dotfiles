# macOS
.DS_Store
**/.DS_Store

# Backup files
*.bak
*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*

# Logs
*.log

# Auto-generated caches
configstore/

# Runtime state (not config)
uv/uv-receipt.json
yarn/global/node_modules/
zed/prompts/
zed/settings_backup.json
yazi/plugins/
wezterm/wezterm-session-manager/wezterm_state_YOUR-ORG.json
thefuck/__pycache__/

# Sensitive tool dirs
github-copilot

# Raycast: binary app data (extensions, AI history, settings) is NOT versioned.
# We only let the theme and README through so they travel across machines.
raycast/*
raycast/extensions/
!raycast/README.md
!raycast/violet-hour.json

# Claude local settings
**/.claude/settings.local.json

# tmux plugins: TPM manages them (prefix+I), not the repo.
# They used to be gitlinks without .gitmodules = unrecoverable in a fresh clone.
tmux/plugins/

# ============================================================================
# Fish: only version what's ours. Everything from fisher/plugins gets
# reinstalled on every machine via `fisher update` reading fish_plugins.
# ============================================================================

# Fish state files (universal vars + atomic-write artifacts): NEVER version.
fish/fish_variables
fish/fish_variables*

# functions/: ignore everything, whitelist only ours.
fish/functions/*
!fish/functions/dy.fish
!fish/functions/log.fish
!fish/functions/ssh.fish

# conf.d/: ignore everything, whitelist only ours (no _tide_init).
fish/conf.d/*
!fish/conf.d/direnv.fish
!fish/conf.d/env.fish
!fish/conf.d/fzf.fish
!fish/conf.d/git.fish
!fish/conf.d/mise.fish
!fish/conf.d/navi.fish
!fish/conf.d/pay-respects.fish
!fish/conf.d/rustup.fish
!fish/conf.d/violet-hour-tide.fish
!fish/conf.d/zoxide.fish
# zz- forces load AFTER fzf.fish so atuin keeps Ctrl-R.
!fish/conf.d/zz-atuin.fish

# completions/: binaries generate them on install. Nothing to version.
fish/completions/*

# ============================================================================
# Personal layer: workflow-specific for the current user (work abbrs,
# private orgs, internal tools). The public repo only versions the README
# scaffold so a fork knows this layer exists.
# ============================================================================
personal/*
!personal/README.md

# ============================================================================
# GitHub CLI: auth state and per-machine config. Never version.
# ============================================================================
gh/hosts.yml

# ============================================================================
# Preventive secret patterns. If a future edit slips one in, gitignore
# still catches it before push.
# ============================================================================
.env
.env.*
.envrc
*.pem
*.key
id_rsa*
id_ed25519*
*_rsa
*_ed25519
.secrets.*
*.secret
*.token
credentials.json
service-account*.json

# gh-dash: the real config.yml holds your actual org filters. Public template
# lives at config.yml.example. On a fresh machine: `cp config.yml.example config.yml`
# and edit YOUR-ORG in place.
gh-dash/config.yml
gh-dash/config.yml.local

# ============================================================================
# jira-cli: contiene email de login, server corporativo, board/project IDs.
# ============================================================================
.jira/
