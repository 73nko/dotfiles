<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>Glacier Signal</string>
  <key>uuid</key><string>7E0F0A7E-9090-49B2-A9F7-7E0F90A77E0F</string>
  <key>semanticClass</key><string>theme.dark.glacier-signal</string>
  <key>colorSpaceName</key><string>sRGB</string>
  <key>settings</key>
  <array>
    <!-- Editor chrome — matches Style Guide v2 §05 -->
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#062230</string>
        <key>foreground</key><string>#f3faf7</string>
        <key>caret</key><string>#5ff2cf</string>
        <key>lineHighlight</key><string>#7fe0ff10</string>
        <key>selection</key><string>#22b8f538</string>
        <key>selectionBorder</key><string>#22b8f555</string>
        <key>invisibles</key><string>#c3d9d659</string>
        <key>guide</key><string>#7fe0ff1F</string>
        <key>activeGuide</key><string>#7fe0ff59</string>
        <key>stackGuide</key><string>#7fe0ff1F</string>
        <key>findHighlight</key><string>#e0fbff24</string>
        <key>findHighlightForeground</key><string>#e0fbff</string>
        <key>misspelling</key><string>#5ff2cf</string>
        <key>bracketsForeground</key><string>#5ff2cf</string>
        <key>bracketsOptions</key><string>underline</string>
        <key>bracketContentsForeground</key><string>#5ff2cf</string>
        <key>tagsOptions</key><string>stippled_underline</string>
      </dict>
    </dict>

    <!-- Comments — ice @ 50% italic -->
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#559eb7</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <!-- Punctuation — silver @ 45% -->
    <dict>
      <key>name</key><string>Punctuation</string>
      <key>scope</key><string>punctuation, meta.brace, meta.delimiter</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c3d9d673</string>
      </dict>
    </dict>

    <!-- Keywords / control flow / operators — signal -->
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, keyword.control, keyword.operator, storage.type.function, storage.modifier</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#22b8f5</string>
      </dict>
    </dict>

    <!-- Operators -->
    <dict>
      <key>name</key><string>Operator</string>
      <key>scope</key><string>keyword.operator, punctuation.accessor</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#22b8f5</string>
      </dict>
    </dict>

    <!-- Storage (var/let/const/static/etc.) -->
    <dict>
      <key>name</key><string>Storage</string>
      <key>scope</key><string>storage, storage.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#22b8f5</string>
      </dict>
    </dict>

    <!-- Strings — ice -->
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, string.quoted, string.template</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#8fdc8f</string>
      </dict>
    </dict>

    <!-- String escape / interpolation -->
    <dict>
      <key>name</key><string>String escape</string>
      <key>scope</key><string>constant.character.escape, punctuation.definition.template-expression</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ff7a6e</string>
      </dict>
    </dict>

    <!-- Regex -->
    <dict>
      <key>name</key><string>Regex</string>
      <key>scope</key><string>string.regexp</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#8fdc8f</string>
      </dict>
    </dict>

    <!-- Numbers / booleans / null -->
    <dict>
      <key>name</key><string>Numeric</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.language.boolean, constant.language.null</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ffd873</string>
      </dict>
    </dict>

    <!-- Constants -->
    <dict>
      <key>name</key><string>Constant</string>
      <key>scope</key><string>constant, support.constant</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ffd873</string>
      </dict>
    </dict>

    <!-- Functions / methods / constructors — mint -->
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, meta.function-call, support.function, variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ffd873</string>
      </dict>
    </dict>

    <!-- Function parameters — snow (default fg) -->
    <dict>
      <key>name</key><string>Parameter</string>
      <key>scope</key><string>variable.parameter, meta.parameter</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#f3faf7</string>
      </dict>
    </dict>

    <!-- Types / classes — cyan mist -->
    <dict>
      <key>name</key><string>Type</string>
      <key>scope</key><string>support.type, support.class, entity.name.type, entity.name.class, entity.name.namespace, storage.type.primitive, storage.type.built-in</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#5ff2cf</string>
      </dict>
    </dict>

    <!-- Variables — snow (default fg) -->
    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, variable.other</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#f3faf7</string>
      </dict>
    </dict>

    <!-- Property / field — signal (per §05) -->
    <dict>
      <key>name</key><string>Property</string>
      <key>scope</key><string>variable.other.property, variable.other.member, meta.property, support.type.property-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#b8f1ff</string>
      </dict>
    </dict>

    <!-- HTML/JSX tags — signal -->
    <dict>
      <key>name</key><string>Tag</string>
      <key>scope</key><string>entity.name.tag, meta.tag</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#22b8f5</string>
      </dict>
    </dict>

    <!-- HTML/JSX attribute — mint -->
    <dict>
      <key>name</key><string>Tag attribute</string>
      <key>scope</key><string>entity.other.attribute-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#5ff2cf</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <!-- Decorators -->
    <dict>
      <key>name</key><string>Decorator</string>
      <key>scope</key><string>meta.decorator, punctuation.decorator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ffd873</string>
      </dict>
    </dict>

    <!-- This / self / super -->
    <dict>
      <key>name</key><string>this/self</string>
      <key>scope</key><string>variable.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#22b8f5</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <!-- Imports / exports -->
    <dict>
      <key>name</key><string>Import</string>
      <key>scope</key><string>keyword.control.import, keyword.control.export, keyword.control.from</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#22b8f5</string>
      </dict>
    </dict>

    <!-- Markdown headings -->
    <dict>
      <key>name</key><string>Markdown heading</string>
      <key>scope</key><string>markup.heading</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#a8ecff</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>

    <!-- Markdown bold/italic/strike -->
    <dict>
      <key>name</key><string>Markdown bold</string>
      <key>scope</key><string>markup.bold</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#a8ecff</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Markdown italic</string>
      <key>scope</key><string>markup.italic</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#e0fbff</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Markdown link</string>
      <key>scope</key><string>markup.underline.link, string.other.link</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#7fe0ff</string>
        <key>fontStyle</key><string>underline</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Markdown code</string>
      <key>scope</key><string>markup.raw, markup.inline.raw</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#e0fbff</string>
      </dict>
    </dict>

    <!-- Diff — add Green / del Coral / change Orange (convencional, legible) -->
    <dict>
      <key>name</key><string>Diff inserted</string>
      <key>scope</key><string>markup.inserted, meta.diff.header.to-file</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#8fdc8f</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Diff deleted</string>
      <key>scope</key><string>markup.deleted, meta.diff.header.from-file</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ff7a6e</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Diff changed</string>
      <key>scope</key><string>markup.changed</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ffd873</string>
      </dict>
    </dict>

    <!-- Errors and warnings (LSP diagnostics) -->
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, invalid.illegal</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#ff7a6e</string>
        <key>fontStyle</key><string>underline</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Deprecated</string>
      <key>scope</key><string>invalid.deprecated</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#839b9e</string>
        <key>fontStyle</key><string>strikethrough</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
