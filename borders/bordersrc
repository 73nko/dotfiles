#!/bin/bash
# ============================================================================
# JankyBorders — Violet Hour · Glass
# ----------------------------------------------------------------------------
# Guide v2 §05: pane/window borders are "cool when focused, violet when idle".
# Ice carries focus; orchid hums quietly in the background.
#
#   Active   = Ice    #A8C9FF @ 90%   -> 0xe6a8c9ff
#   Inactive = Orchid #B39DFF @ 22%   -> 0x38b39dff   (hairline whisper)
#   Style    = round, width 4.0, hidpi on
# ============================================================================

options=(
	style=round
	width=4.0
	hidpi=on
	background_color=0x00000000
	active_color=0xe6a8c9ff
	inactive_color=0x38b39dff
	blur_radius=2.0
)

borders "${options[@]}"
