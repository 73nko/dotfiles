#!/bin/bash
# ============================================================================
# JankyBorders — Glacier Signal
# ----------------------------------------------------------------------------
# Guide v2 §05: pane/window borders are ice when focused, signal when idle.
# Ice carries focus; signal hums quietly in the background.
#
#   Active   = Ice    #7fe0ff @ 90%   -> 0xe67fe0ff
#   Inactive = Signal #22b8f5 @ 22%   -> 0x3822b8f5   (hairline whisper)
#   Style    = round, width 4.0, hidpi on
# ============================================================================

options=(
	style=round
	width=4.0
	hidpi=on
	background_color=0x00000000
	active_color=0xe67fe0ff
	inactive_color=0x3822b8f5
	blur_radius=2.0
)

borders "${options[@]}"
