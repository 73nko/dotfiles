#!/bin/bash
# ============================================================================
# JankyBorders — Sunset · Pool Splash
# ----------------------------------------------------------------------------
# Aligned with Style Guide §04 ("Pane borders: cool when focused, warm when
# idle") and the §02 rule that turquoise carries structure / focus.
#
#   Active   = Turquoise Hi #7FE0EB @ 90%   -> 0xe67fe0eb
#   Inactive = Magenta      #FF3D8A @ 10%   -> 0x1aff3d8a   (whisper-tenue)
#   Style    = round, width 4.0, hidpi on
# ============================================================================

options=(
	style=round
	width=4.0
	hidpi=on
	background_color=0x00000000
	active_color=0xe67fe0eb
	inactive_color=0xffff3d8a
	blur_radius=2.0
)

borders "${options[@]}"
