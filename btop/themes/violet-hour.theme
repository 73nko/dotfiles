#  Btop theme  ·  Violet Hour · Glass
#  Aligned with ~/.config/Styles/Violet Hour · Glass.html — cool sets the tone.
#  -------------------------------------------------------------------
#  Identity        orchid #22b8f5 · lilac #a8ecff · rose-mist #5ff2cf · bloom #e0fbff
#  Structure       periwinkle #5f9bd8 · ice #7fe0ff · cyan-mist #B9E0FF
#  Ground          night #062230 · indigo #0d3547 · star #f3faf7
#  -------------------------------------------------------------------

# Main area — night base, star foreground (transparent if theme_background=false)
theme[main_bg]="#062230"
theme[main_fg]="#f3faf7"

# Title and major highlight
theme[title]="#f3faf7"
theme[hi_fg]="#22b8f5"

# Selected background/foreground
theme[selected_bg]="#0d3547"
theme[selected_fg]="#a8ecff"

# Inactive elements — muted ice
theme[inactive_fg]="#839b9e"

# Text inside graphs/meters
theme[graph_text]="#f3faf7"

# Misc element coloring (process state, mem available, etc.)
theme[meter_bg]="#0d3547"
theme[proc_misc]="#7fe0ff"

# CPU box — orchid border (identity)
theme[cpu_box]="#22b8f5"

# Memory box — ice (cool/structural)
theme[mem_box]="#7fe0ff"

# Network box — cyan mist
theme[net_box]="#b9e0ff"

# Processes box — lilac
theme[proc_box]="#a8ecff"

# Single-bar dividers between boxes
theme[div_line]="#113e51"

# CPU temperature gradient: cool → identity → loud
theme[temp_start]="#7fe0ff"
theme[temp_mid]="#22b8f5"
theme[temp_end]="#5ff2cf"

# CPU usage gradient: cyan-mist (idle) → periwinkle (busy) → orchid (max)
theme[cpu_start]="#b9e0ff"
theme[cpu_mid]="#5f9bd8"
theme[cpu_end]="#22b8f5"

# Memory: free → available → cached → used (ice → cyan-mist → periwinkle → orchid)
theme[free_start]="#7fe0ff"
theme[free_mid]=""
theme[free_end]=""
theme[available_start]="#b9e0ff"
theme[available_mid]=""
theme[available_end]=""
theme[cached_start]="#5f9bd8"
theme[cached_mid]=""
theme[cached_end]=""
theme[used_start]="#22b8f5"
theme[used_mid]="#5ff2cf"
theme[used_end]="#5ff2cf"

# Disk I/O gradient
theme[download_start]="#b9e0ff"
theme[download_mid]="#7fe0ff"
theme[download_end]="#5f9bd8"
theme[upload_start]="#5f9bd8"
theme[upload_mid]="#22b8f5"
theme[upload_end]="#5ff2cf"

# Process activity gradient: idle → active → hot
theme[process_start]="#7fe0ff"
theme[process_mid]="#22b8f5"
theme[process_end]="#5ff2cf"
