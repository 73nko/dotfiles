#  Btop theme  ·  Violet Hour · Glass
#  Aligned with ~/.config/Styles/Violet Hour · Glass.html — cool sets the tone.
#  -------------------------------------------------------------------
#  Identity        orchid #B39DFF · lilac #D6C8FF · rose-mist #E2BCFF · bloom #F0D2FF
#  Structure       periwinkle #8DA7FF · ice #A8C9FF · cyan-mist #B9E0FF
#  Ground          night #0D0D2C · indigo #1A1745 · star #ECE6FF
#  -------------------------------------------------------------------

# Main area — night base, star foreground (transparent if theme_background=false)
theme[main_bg]="#0d0d2c"
theme[main_fg]="#ece6ff"

# Title and major highlight
theme[title]="#ece6ff"
theme[hi_fg]="#b39dff"

# Selected background/foreground
theme[selected_bg]="#1a1745"
theme[selected_fg]="#d6c8ff"

# Inactive elements — muted ice
theme[inactive_fg]="#5b6b96"

# Text inside graphs/meters
theme[graph_text]="#ece6ff"

# Misc element coloring (process state, mem available, etc.)
theme[meter_bg]="#1a1745"
theme[proc_misc]="#a8c9ff"

# CPU box — orchid border (identity)
theme[cpu_box]="#b39dff"

# Memory box — ice (cool/structural)
theme[mem_box]="#a8c9ff"

# Network box — cyan mist
theme[net_box]="#b9e0ff"

# Processes box — lilac
theme[proc_box]="#d6c8ff"

# Single-bar dividers between boxes
theme[div_line]="#211e45"

# CPU temperature gradient: cool → identity → loud
theme[temp_start]="#a8c9ff"
theme[temp_mid]="#b39dff"
theme[temp_end]="#e2bcff"

# CPU usage gradient: cyan-mist (idle) → periwinkle (busy) → orchid (max)
theme[cpu_start]="#b9e0ff"
theme[cpu_mid]="#8da7ff"
theme[cpu_end]="#b39dff"

# Memory: free → available → cached → used (ice → cyan-mist → periwinkle → orchid)
theme[free_start]="#a8c9ff"
theme[free_mid]=""
theme[free_end]=""
theme[available_start]="#b9e0ff"
theme[available_mid]=""
theme[available_end]=""
theme[cached_start]="#8da7ff"
theme[cached_mid]=""
theme[cached_end]=""
theme[used_start]="#b39dff"
theme[used_mid]="#e2bcff"
theme[used_end]="#e2bcff"

# Disk I/O gradient
theme[download_start]="#b9e0ff"
theme[download_mid]="#a8c9ff"
theme[download_end]="#8da7ff"
theme[upload_start]="#8da7ff"
theme[upload_mid]="#b39dff"
theme[upload_end]="#e2bcff"

# Process activity gradient: idle → active → hot
theme[process_start]="#a8c9ff"
theme[process_mid]="#b39dff"
theme[process_end]="#e2bcff"
