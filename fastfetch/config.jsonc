{
  // The actual logo (work, personal, whatever) lives in the personal layer.
  // If you fork this repo and don't have one, either drop your own ASCII art
  // at ~/.config/personal/fastfetch/logo.txt or change "type" to "auto" for
  // the default OS logo.
  "logo": {
    "type": "file-raw",
    "source": "~/.config/personal/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    },
    "size": {
      "binaryPrefix": "si"
    },
    "key": {
      "width": 11,
      "type": "string"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    "separator",

    { "type": "os",          "key": "  os" },
    { "type": "host",        "key": "  host" },
    { "type": "kernel",      "key": "  kern" },
    { "type": "uptime",      "key": "󰅐  up" },
    { "type": "packages",    "key": "󰏖  pkg" },
    { "type": "shell",       "key": "  sh" },
    { "type": "terminal",    "key": "  term" },
    { "type": "wm",          "key": "  wm" },
    { "type": "terminalfont","key": "  font" },

    "break",

    { "type": "cpu",     "key": "  cpu" },
    { "type": "gpu",     "key": "󰢮  gpu" },
    { "type": "memory",  "key": "󰍛  ram" },
    { "type": "disk",    "key": "󰋊  disk", "folders": "/" },
    { "type": "battery", "key": "  batt", "format": "{1} ({4})" },
    { "type": "locale",  "key": "󰗊  lang" },

    "break",

    {
      "type": "colors",
      "paddingLeft": 3,
      "symbol": "circle"
    }
  ]
}
