# gh-dash · Violet Hour · Glass
# Run with:  gh dash
# Switch sections with:  Tab / Shift+Tab
# Switch PRs/Issues with:  s
# Filter:  /

prSections:
  - title: Reviews waiting on me
    filters: is:open review-requested:@me archived:false
    limit: 50
  - title: My open PRs
    filters: is:open author:@me archived:false
    limit: 30
  - title: YOUR-ORG — all open
    filters: is:open org:YOUR-ORG archived:false
    limit: 50
  - title: Mentioned & assigned
    filters: is:open mentions:@me archived:false
    limit: 30
  - title: Recently merged (mine)
    filters: is:merged author:@me
    limit: 20
    layout:
      title:
        grow: true
      author:
        hidden: true

issuesSections:
  - title: Assigned to me
    filters: is:open assignee:@me archived:false
    limit: 50
  - title: My open issues
    filters: is:open author:@me archived:false
    limit: 30
  - title: YOUR-ORG — all open
    filters: is:open org:YOUR-ORG archived:false
    limit: 50

defaults:
  preview:
    open: true
    width: 50
  prsLimit: 50
  issuesLimit: 50
  view: prs
  layout:
    prs:
      updatedAt:
        width: 7
      repo:
        width: 28
      author:
        width: 16
      authorIcon:
        hidden: false
      assignees:
        width: 14
      base:
        width: 12
        hidden: false
      lines:
        width: 16
    issues:
      updatedAt:
        width: 7
      repo:
        width: 28
      creator:
        width: 16
      assignees:
        width: 14
  refetchIntervalMinutes: 30
  dateFormat: "DD-MM-YY"

# Theme — Violet Hour · Glass
theme:
  ui:
    sectionsShowCount: true
    table:
      showSeparator: true
      compact: false
  colors:
    text:
      primary:   "#f3faf7"   # star
      secondary: "#7fe0ff"   # ice
      inverted:  "#062230"   # night
      faint:     "#839b9e"   # silver @ 58% pre-mixed over night
      warning:   "#e0fbff"   # bloom
      success:   "#7fe0ff"   # ice
      error:     "#5ff2cf"   # rose mist
    background:
      selected:  "#0d3547"   # indigo
    border:
      primary:   "#7fe0ff"   # ice
      secondary: "#0d3547"   # indigo
      faint:     "#113e51"   # orchid @ 12% pre-mixed over night

keybindings:
  prs:
    - key: O
      command: gh pr checkout {{.PrNumber}}
    - key: c
      command: gh pr comment {{.PrNumber}}
  issues: []

repoPaths:
  YOUR-ORG/*: ~/YOUR-ORG
