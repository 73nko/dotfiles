# ============================================
# Ghostty Config — Neon Nocturne (The Luminous Editor)
# ============================================

# Shell
command = /opt/homebrew/bin/fish

# ============================================
# Window
# ============================================
macos-titlebar-style = hidden
background-opacity = 0.90
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-inherit-working-directory = true
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never
bell-features = system,border

# ============================================
# macOS
# ============================================
macos-option-as-alt = true

# ============================================
# Shell Integration (killer feature de Ghostty)
# Permite navegar entre prompts, hereda CWD en splits, etc.
# ============================================
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ============================================
# Mouse
# ============================================
mouse-hide-while-typing = true

# ============================================
# Font
# ============================================
font-family = JetBrainsMono Nerd Font
font-size = 13
adjust-cell-height = -2

# ============================================
# Cursor
# ============================================
cursor-style = block
cursor-style-blink = false

# ============================================
# Scrollback
# ============================================
scrollback-limit = 100000

# ============================================
# Selection
# ============================================
copy-on-select = true

# ============================================
# Neon Nocturne — Colors (The Luminous Editor design system)
# ============================================
background = #0a0e14
foreground = #f1f3fc
cursor-color = #81d4fa
cursor-text  = #0a0e14
selection-foreground = #abddad
selection-background = #24502c

# Normal colors (0-7)
palette = 0=#0f141a
palette = 1=#ffa8a3
palette = 2=#abddad
palette = 3=#ffd54f
palette = 4=#81d4fa
palette = 5=#b39ddb
palette = 6=#55aacf
palette = 7=#c5cde0

# Bright colors (8-15)
palette = 8=#3d4f6e
palette = 9=#ffa8a3
palette = 10=#abddad
palette = 11=#ffcc80
palette = 12=#81d4fa
palette = 13=#ce93d8
palette = 14=#81d4fa
palette = 15=#f1f3fc

# ============================================
# Keybindings
# ============================================
keybind = super+q=quit
keybind = super+w=close_window
keybind = super+n=new_window
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard


# Scroll
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# Borrar palabra/línea (Mac-style)
keybind = super+backspace=text:\x15
keybind = alt+backspace=text:\x17

# ============================================
# Vim-mode keytable — navegar el scrollback con vim bindings
# Activar con alt+v, salir con esc / q / i
# ============================================
keybind = alt+v=activate_key_table:vim

# Movimiento línea / página
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

# Top / bottom
keybind = vim/shift+g=scroll_to_bottom

# Copy / yank
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard

# Salir
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table

