# ============================================
# Ghostty Config — Tokyo Night (custom, matched to nvim)
# ============================================

# Shell
command = /opt/homebrew/bin/fish

# ============================================
# Window
# ============================================
macos-titlebar-style = hidden
background-opacity = 0.85
window-padding-x = 3
window-padding-y = 5
window-inherit-working-directory = true
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never

# ============================================
# macOS
# ============================================
macos-option-as-alt = true

# ============================================
# Shell Integration (killer feature de Ghostty)
# Permite navegar entre prompts, hereda CWD en splits, etc.
# ============================================
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ============================================
# Mouse
# ============================================
mouse-hide-while-typing = true

# ============================================
# Font
# ============================================
font-family = JetBrainsMono Nerd Font
font-size = 13
adjust-cell-height = -2

# ============================================
# Cursor
# ============================================
cursor-style = block
cursor-style-blink = false

# ============================================
# Scrollback
# ============================================
scrollback-limit = 100000

# ============================================
# Selection
# ============================================
copy-on-select = true

# ============================================
# Tokyo Night — Colors (matched to nvim on_colors/on_highlights)
# ============================================
background = #06080f
foreground = #e2e8f0
cursor-color = #c4a7ff
cursor-text  = #06080f
selection-foreground = #e2e8f0
selection-background = #1e2d4a

# Normal colors (0-7)
palette = 0=#111827
palette = 1=#f472b6
palette = 2=#6ee7a0
palette = 3=#fde68a
palette = 4=#89b4fa
palette = 5=#c4a7ff
palette = 6=#56d4e0
palette = 7=#e2e8f0

# Bright colors (8-15)
palette = 8=#3b4566
palette = 9=#f472b6
palette = 10=#6ee7a0
palette = 11=#fdba74
palette = 12=#7dcfff
palette = 13=#c4a7ff
palette = 14=#7dcfff
palette = 15=#ffffff

# ============================================
# Keybindings
# ============================================
keybind = super+q=quit
keybind = super+w=close_window
keybind = super+n=new_window
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard


# Scroll
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# Borrar palabra/línea (Mac-style)
keybind = super+backspace=text:\x15
keybind = alt+backspace=text:\x17

