# ============================================
# Ghostty Config - Glacier Signal
# Ten minutes after sunset: deep fjord, glass, aurora
# ============================================

# ============================================
# Window - heavy glass, the wallpaper is the light
# ============================================
macos-titlebar-style = hidden
background-opacity = 0.55
background-blur-radius = 40
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-inherit-working-directory = true
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never
bell-features = system,border

# ============================================
# macOS
# ============================================
macos-option-as-alt = true

# ============================================
# Shell Integration
# ============================================
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ============================================
# Mouse
# ============================================
mouse-hide-while-typing = true

# ============================================
# Font - Monaspace Neon NF con fallback JetBrains Mono
# Guide v2 §04: 13.5pt, mas aire que Sunset (la glass necesita espacio)
# ============================================
font-family = Monaspace Neon
font-family = JetBrainsMono Nerd Font
font-size = 13.5
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
adjust-cell-height = 8%
font-style-italic = Italic

# ============================================
# Cursor - Mint Mist block, sin blink (§07: visible pero no insistente)
# ============================================
cursor-style = block
cursor-style-blink = false
cursor-color = #5ff2cf
cursor-text = #062230

# ============================================
# Scrollback
# ============================================
scrollback-limit = 100000

# ============================================
# Selection / Copy - Signal wash (§07)
# ============================================
copy-on-select = true
selection-background = #0f526f
selection-foreground = #f3faf7

# ============================================
# Glacier Signal palette
# background = Night #062230 @55% con blur 40 sobre wallpaper aurora
# foreground = Snow #f3faf7
# ============================================
background = #062230
foreground = #f3faf7

# Normal (0-7) — ANSI con verde/rojo/amarillo REALES (rediseno 2026-06).
# Antes el slot verde era azul y el rojo era rosa: ls/git/fish salian
# monocromos. Ahora cada slot lleva su color de verdad, igual que el bloque
# terminal_color_* del tema de nvim.
# 0 black  = Abyss      4 blue    = Azure
# 1 red    = Coral      5 magenta = Signal (identidad)
# 2 green  = Green      6 cyan    = Teal
# 3 yellow = Gold       7 white   = Silver
palette = 0=#04141c
palette = 1=#FF7A6E
palette = 2=#8FDC8F
palette = 3=#FFD873
palette = 4=#5f9bd8
palette = 5=#22b8f5
palette = 6=#5ff2cf
palette = 7=#C3D9D6

# Bright (8-15)
# 8  bright black  = Pane Active (lifted, visible)
# 9  bright red    = Coral        12 bright blue  = Azure
# 10 bright green  = Green        13 bright mag   = Glow
# 11 bright yellow = Gold         14 bright cyan  = Teal
#                                 15 bright white = Snow
palette = 8=#0d3547
palette = 9=#FF7A6E
palette = 10=#8FDC8F
palette = 11=#FFD873
palette = 12=#7fe0ff
palette = 13=#a8ecff
palette = 14=#b8f1ff
palette = 15=#f3faf7

# ============================================
# Keybindings (sin cambios)
# ============================================
keybind = super+q=quit
keybind = super+w=close_window
keybind = super+n=new_window
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Scroll
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# Mac-style word/line erase
keybind = super+backspace=text:\x15
keybind = alt+backspace=text:\x17

# ============================================
# Vim-mode keytable para navegar scrollback
# Activar con alt+v, salir con esc / q / i
# ============================================
keybind = alt+v=activate_key_table:vim
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up
keybind = vim/shift+g=scroll_to_bottom
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table
