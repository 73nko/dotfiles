# ============================================
# Ghostty Config - Violet Hour · Glass
# Ten minutes after sunset: deep indigo, glass, aurora
# ============================================

# ============================================
# Window - heavy glass, the wallpaper is the light
# ============================================
macos-titlebar-style = hidden
background-opacity = 0.55
background-blur-radius = 40
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-inherit-working-directory = true
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never
bell-features = system,border

# ============================================
# macOS
# ============================================
macos-option-as-alt = true

# ============================================
# Shell Integration
# ============================================
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ============================================
# Mouse
# ============================================
mouse-hide-while-typing = true

# ============================================
# Font - Monaspace Neon NF con fallback JetBrains Mono
# Guide v2 §04: 13.5pt, mas aire que Sunset (la glass necesita espacio)
# ============================================
font-family = Monaspace Neon
font-family = JetBrainsMono Nerd Font
font-size = 13.5
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
adjust-cell-height = 8%
font-style-italic = Italic

# ============================================
# Cursor - Rose Mist block, sin blink (§07: visible pero no insistente)
# ============================================
cursor-style = block
cursor-style-blink = false
cursor-color = #E2BCFF
cursor-text = #0D0D2C

# ============================================
# Scrollback
# ============================================
scrollback-limit = 100000

# ============================================
# Selection / Copy - Orchid wash (§07)
# ============================================
copy-on-select = true
selection-background = #322d5a
selection-foreground = #ECE6FF

# ============================================
# Violet Hour · Glass palette
# background = Night #0D0D2C @55% con blur 40 sobre wallpaper aurora
# foreground = Star #ECE6FF
# ============================================
background = #0D0D2C
foreground = #ECE6FF

# Normal (0-7) — §07 ANSI mapping
# 0 black  = Abyss
# 1 red    = Rose Mist (gentler than real red, still distinct)
# 2 green  = Ice (cool axis, collapsed onto "green" slot)
# 3 yellow = Bloom
# 4 blue   = Periwinkle
# 5 magenta= Orchid (identity)
# 6 cyan   = Cyan Mist
# 7 white  = Silver
palette = 0=#06061A
palette = 1=#E2BCFF
palette = 2=#A8C9FF
palette = 3=#F0D2FF
palette = 4=#8DA7FF
palette = 5=#B39DFF
palette = 6=#B9E0FF
palette = 7=#C4BEE0

# Bright (8-15)
# 8  bright black  = Indigo
# 9  bright red    = Bloom
# 10 bright green  = Cyan Mist
# 11 bright yellow = Lilac
# 12 bright blue   = Ice
# 13 bright mag    = Lilac
# 14 bright cyan   = Ice
# 15 bright white  = Star
palette = 8=#1A1745
palette = 9=#F0D2FF
palette = 10=#B9E0FF
palette = 11=#D6C8FF
palette = 12=#A8C9FF
palette = 13=#D6C8FF
palette = 14=#A8C9FF
palette = 15=#ECE6FF

# ============================================
# Keybindings (sin cambios)
# ============================================
keybind = super+q=quit
keybind = super+w=close_window
keybind = super+n=new_window
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Scroll
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# Mac-style word/line erase
keybind = super+backspace=text:\x15
keybind = alt+backspace=text:\x17

# ============================================
# Vim-mode keytable para navegar scrollback
# Activar con alt+v, salir con esc / q / i
# ============================================
keybind = alt+v=activate_key_table:vim
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up
keybind = vim/shift+g=scroll_to_bottom
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table
