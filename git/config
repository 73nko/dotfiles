# Global git config versioned under ~/.config (XDG).
#
# Priority notes:
# - ~/.gitconfig (if present) takes precedence over this file.
# - Keep identity (user.name, user.email) and signing in ~/.gitconfig
#   so emails don't get exposed in the public dotfiles repo.
# - This file only holds reasonable defaults portable across machines.
#
# Prerequisites: delta (git-delta via brew) for the pager. If you don't have it:
#   brew install git-delta

[core]
  editor = nvim
  pager = delta
  # fsmonitor enables the macOS daemon to detect changes without scanning.
  # Dramatic improvement on large repos (monorepos).
  fsmonitor = true
  # Untracked-cache so git status doesn't re-scan everything on every call.
  untrackedCache = true

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  light = false
  side-by-side = false
  line-numbers = true
  # Custom theme registered via `bat cache --build` in migrate-terminal-setup.
  # If delta can't find it (e.g. on a fresh machine before the first bat cache
  # rebuild), it falls back to default. Nothing breaks.
  syntax-theme = Glacier Signal
  # Clickable paths on terminals that support OSC 8 (ghostty, iterm2, kitty).
  hyperlinks = true

[diff]
  # colorMoved colors moved blocks distinctly from pure additions/deletions.
  colorMoved = default
  # The histogram algorithm detects refactors better than the default Myers.
  algorithm = histogram

[merge]
  # zdiff3 shows the common ancestor in conflict markers. Helps understand
  # what each side changed, not just what's in conflict.
  conflictstyle = zdiff3

[rerere]
  # rerere = "reuse recorded resolution". Remembers how you resolved a
  # conflict and reapplies it next time. Useful in long rebases.
  enabled = true
  autoUpdate = true

[branch]
  # List branches by last commit date, most recent first.
  sort = -committerdate

[tag]
  # Tags sorted by semver, not alphabetically.
  sort = -version:refname

[fetch]
  # Delete local refs for branches that no longer exist on the remote.
  prune = true
  pruneTags = true
  # Parallelize fetches across multiple remotes.
  parallel = 0

[rebase]
  # Auto-stash pending changes before rebase, restore them afterwards.
  autoStash = true
  # autoSquash respects commits prefixed with fixup! / squash!.
  autoSquash = true
  # Update branch refs stacked on top of the rebase.
  updateRefs = true

[pull]
  # ff = only prevents accidental merge commits. If a fast-forward is not
  # possible, it fails and forces you to rebase explicitly.
  ff = only

[push]
  # autoSetupRemote avoids the eternal "git push --set-upstream origin branch".
  autoSetupRemote = true
  # Push only the current branch to its upstream.
  default = simple
  # Verify remote refs before pushing (protection against broken force-push).
  followTags = true
  # useForceIfIncludes hace --force-with-lease seguro de verdad: aborta si el
  # remote avanzo desde el ultimo fetch en background.
  useForceIfIncludes = true

[init]
  defaultBranch = main

[help]
  # If you mistype a command, get suggestions instead of a hard error.
  autocorrect = prompt

[column]
  # git branch / git status in columns if the terminal is wide.
  ui = auto

[commit]
  verbose = true

[log]
  # Relative date format (2 hours ago) in logs.
  date = relative

[status]
  # Show branch tracking info in git status.
  branch = true
  showStash = true

# Firma de commits via 1Password (SSH). Los VALORES viven en ~/.gitconfig
# (identidad y firma no se versionan; ver cabecera de este fichero).
# Setup una vez por maquina:
#   1. 1Password -> Settings -> Developer: habilitar SSH agent y crear clave
#   2. git config --file ~/.gitconfig gpg.format ssh
#   3. git config --file ~/.gitconfig user.signingkey 'ssh-ed25519 AAAA...'
#   4. git config --file ~/.gitconfig gpg.ssh.program \
#        "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
#   5. git config --file ~/.gitconfig commit.gpgsign true
#   6. GitHub -> Settings -> SSH and GPG keys -> New SSH key (tipo: Signing Key)
