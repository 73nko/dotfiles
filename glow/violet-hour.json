{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#ece6ff",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#b39dff",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#f0d2ff",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#0d0d2c",
    "background_color": "#f0d2ff",
    "bold": true
  },
  "h2": {
    "prefix": "── ",
    "color": "#e2bcff",
    "bold": true
  },
  "h3": {
    "prefix": "▸ ",
    "color": "#d6c8ff",
    "bold": true
  },
  "h4": {
    "prefix": "• ",
    "color": "#b39dff",
    "bold": true
  },
  "h5": {
    "prefix": "· ",
    "color": "#a8c9ff"
  },
  "h6": {
    "prefix": "· ",
    "color": "#8da7ff",
    "italic": true
  },
  "text": {
    "color": "#ece6ff"
  },
  "strikethrough": {
    "crossed_out": true,
    "color": "#777494"
  },
  "emph": {
    "italic": true,
    "color": "#a8c9ff"
  },
  "strong": {
    "bold": true,
    "color": "#f0d2ff"
  },
  "hr": {
    "color": "#2f365a",
    "format": "\n────────────────────────────────────────────────────────────────────────────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "✔ ",
    "unticked": "☐ "
  },
  "link": {
    "color": "#8da7ff",
    "underline": true
  },
  "link_text": {
    "color": "#a8c9ff",
    "bold": true
  },
  "image": {
    "color": "#b39dff",
    "underline": true
  },
  "image_text": {
    "color": "#a8c9ff",
    "format": "🖼  {{.text}}"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e2bcff",
    "background_color": "#1a1745"
  },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#ece6ff"
      },
      "error": {
        "color": "#f0d2ff",
        "background_color": "#1a1745"
      },
      "comment": {
        "color": "#777494",
        "italic": true
      },
      "comment_preproc": {
        "color": "#777494"
      },
      "keyword": {
        "color": "#b39dff",
        "bold": true
      },
      "keyword_reserved": {
        "color": "#b39dff",
        "bold": true
      },
      "keyword_namespace": {
        "color": "#b39dff"
      },
      "keyword_type": {
        "color": "#8da7ff"
      },
      "operator": {
        "color": "#a8c9ff"
      },
      "punctuation": {
        "color": "#a8c9ff"
      },
      "name": {
        "color": "#ece6ff"
      },
      "name_builtin": {
        "color": "#8da7ff"
      },
      "name_tag": {
        "color": "#f0d2ff"
      },
      "name_attribute": {
        "color": "#e2bcff"
      },
      "name_class": {
        "color": "#a8c9ff",
        "bold": true
      },
      "name_constant": {
        "color": "#e2bcff"
      },
      "name_decorator": {
        "color": "#f0d2ff"
      },
      "name_exception": {
        "color": "#f0d2ff",
        "bold": true
      },
      "name_function": {
        "color": "#8da7ff"
      },
      "name_other": {
        "color": "#ece6ff"
      },
      "literal": {
        "color": "#d6c8ff"
      },
      "literal_number": {
        "color": "#e2bcff"
      },
      "literal_date": {
        "color": "#e2bcff"
      },
      "literal_string": {
        "color": "#d6c8ff"
      },
      "literal_string_escape": {
        "color": "#f0d2ff"
      },
      "generic_deleted": {
        "color": "#f0d2ff",
        "background_color": "#3a1550"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#a8c9ff",
        "background_color": "#1a1745"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#b39dff"
      },
      "background": {
        "background_color": "#0d0d2c"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n▸ "
  },
  "html_block": {},
  "html_span": {}
}
