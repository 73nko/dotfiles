# If you encounter any issues, please make sure you're using the latest version of yazi.
# https://github.com/sxyazi/yazi/blob/main/yazi-config/src/keymap/keymap.rs

[[manager.prepend_keymap]]
on = ["g", "h"]
run = "cd ~"
desc = "Go home"

[[manager.prepend_keymap]]
on = ["g", "c"]
run = "cd ~/.config"
desc = "Go to config"

[[manager.prepend_keymap]]
on = ["g", "d"]
run = "cd ~/Downloads"
desc = "Go to Downloads"

[[manager.prepend_keymap]]
on = ["g", "D"]
run = "cd ~/Desktop"
desc = "Go to Desktop"

[[manager.prepend_keymap]]
on = ["g", "t"]
run = "cd /tmp"
desc = "Go to temporary directory"

[[manager.prepend_keymap]]
on = ["."]
run = "hidden toggle"
desc = "Toggle hidden files"

[[manager.prepend_keymap]]
on = ["T"]
run = "tab_create --current"
desc = "Create a new tab with current path"

[[manager.prepend_keymap]]
on = ["M"]
run = "plugin max-preview"
desc = "Maximize or restore preview"

[[manager.prepend_keymap]]
on = ["c", "m"]
run = "plugin chmod"
desc = "Chmod on selected files"

[[manager.prepend_keymap]]
on = ["<C-s>"]
run = 'shell "$SHELL" --block --confirm'
desc = "Open shell here"

[[manager.prepend_keymap]]
on = ["k"]
run = "arrow -1"
desc = "Move cursor up"

[[manager.prepend_keymap]]
on = ["j"]
run = "arrow 1"
desc = "Move cursor down"

[[manager.prepend_keymap]]
on = ["l"]
run = "plugin --sync smart-enter"
desc = "Enter the child directory, or open the file"

[[manager.prepend_keymap]]
on = ["h"]
run = "leave"
desc = "Go back to the parent directory"

[[manager.prepend_keymap]]
on = ["H"]
run = "back"
desc = "Go back in history"

[[manager.prepend_keymap]]
on = ["L"]
run = "forward"
desc = "Go forward in history"

# Git integration bindings (basic)
[[manager.prepend_keymap]]
on = ["g", "s"]
run = "shell 'lazygit' --block --confirm"
desc = "Lazygit"

# Drag and drop (requires compatible terminal)
[[manager.prepend_keymap]]
on = ["<C-n>"]
run = '''
	shell 'dragon -x -i -T "$1"' --confirm
'''
desc = "Drag and drop"
