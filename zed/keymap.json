[
  // ─── Workspace: pane navigation (vim-tmux style) ───────────
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-alt-a": "workspace::AddFolderToProject"
    }
  },

  // ─── Editor: general bindings ──────────────────────────────
  {
    "context": "Editor",
    "bindings": {
      "ctrl-]": "pane::ActivateNextItem",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-g s": "git::StageAndNext",
      "ctrl-g r": "git::Restore",
      "ctrl-g u": "git::UnstageAndNext",
      "ctrl-g a": "git::StageAll",
      "ctrl-g u a": "git::UnstageAll",
      "ctrl-g c": "git::Commit",
      "ctrl-g p": "git::Push",
      "ctrl-g m": "git::GenerateCommitMessage",
      "ctrl-g l": "git::Pull",
      "ctrl-g d d": "git::Diff",
      "ctrl-g d a": "git::Amend",
      "ctrl-g d b": "git::Blame",
      "ctrl-s": "workspace::Save"
    }
  },

  // ─── Vim Normal: leader bindings ───────────────────────────
  {
    "context": "Editor && vim_mode == normal && vim_operator == none && !VimWaiting",
    "bindings": {
      // Panels
      "space e": "project_panel::ToggleFocus",
      "space g": "git_panel::ToggleFocus",
      "space l": "outline_panel::ToggleFocus",
      "space t": "terminal_panel::ToggleFocus",

      // Navigation
      "space space": "file_finder::Toggle",
      "space b q": "pane::CloseOtherItems",
      "space b d": "pane::CloseActiveItem",
      "space tab a": "tab_switcher::ToggleAll",

      // Diagnostics
      "space d d": "diagnostics::Deploy",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPrevDiagnostic",

      // LSP actions (TS/React workflow)
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g t": "editor::GoToTypeDefinition",
      "K": "editor::Hover",

      // Search
      "space s s": "buffer_search::Deploy",
      "space s p": "pane::DeploySearch",

      // AI
      "space a i": "assistant::InlineAssist",
      "space a d": "agent::OpenAgentDiff",
      "space a t": "agent::ToggleFocus",

      // UI toggles
      "space u n": "workspace::ClearAllNotifications",
      "space u b": "git::Blame",
      "space u h": "editor::ToggleInlayHints",

      // Debugger
      "space d b": "editor::ToggleBreakpoint",
      "space d s": "debugger::Start",
      "space d e": "debugger::Stop",
      "space d n": "debugger::Continue",
      "space d c": "debugger::FocusConsole",
      "space d v": "debugger::FocusVariables",
      "space d t": "debugger::FocusTerminal",
      "space d b a": "debugger::ClearAllBreakpoints",
      "space d s o": "debugger::StepOver",
      "space d s i": "debugger::StepInto",

      // External tools (tasks)
      "space g g": [
        "task::Spawn",
        { "task_name": "Lazygit", "reveal_target": "center" }
      ],
      "space f f": [
        "task::Spawn",
        { "task_name": "File Finder", "reveal_target": "center" }
      ],
      "space f d": [
        "task::Spawn",
        { "task_name": "Find Directories", "reveal_target": "center" }
      ],
      "space s g": [
        "task::Spawn",
        { "task_name": "Find in Files", "reveal_target": "center" }
      ],
      "space o b": [
        "task::Spawn",
        { "task_name": "Obsidian", "reveal_target": "center" }
      ],
      "space y": [
        "task::Spawn",
        { "task_name": "Yazi", "reveal_target": "center" }
      ],
      "-": ["task::Spawn", { "task_name": "Oil", "reveal_target": "center" }],
      "space o f": [
        "task::Spawn",
        { "task_name": "Oil Float", "reveal_target": "center" }
      ],
      "space o s": [
        "task::Spawn",
        { "task_name": "Oil Simple", "reveal_target": "center" }
      ],
      "space o z": [
        "task::Spawn",
        { "task_name": "Oil", "reveal_target": "center" }
      ]
    }
  },

  // ─── Vim Visual: AI assist ─────────────────────────────────
  {
    "context": "Editor && vim_mode == visual && !VimWaiting",
    "bindings": {
      "space a i": "assistant::InlineAssist",
      "space c a": "editor::ToggleCodeActions"
    }
  },

  // ─── Terminal ──────────────────────────────────────────────
  {
    "context": "Terminal",
    "bindings": {
      "ctrl_k": "workspace::ToggleBottomDock",
      "cmd-f": "workspace::ToggleZoom",
      "cmd-n": "workspace::NewTerminal"
    }
  },

  // ─── Project Panel ─────────────────────────────────────────
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-r": "project_panel::Rename"
    }
  }
]
